    "i18next": "^26.0.8",
    "isbot": "^5.1.36",
    "lucide-react": "^1.14.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.14.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.14.0",
