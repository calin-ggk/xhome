DATABASE_URL=./var/xhome.db

LOG_LEVEL=info
LOG_DIR=./var/logs
LOG_RETENTION=30

AUTH_USERNAME=admin
# Generate hash: node -e "import('bcryptjs').then(m=>m.default.hash('yourpassword',12).then(console.log))"
AUTH_PASSWORD_HASH=<bcrypt hash of your password>
SESSION_SECRET=<random string, at least 32 characters>

API_KEY=<random string, at least 16 characters>

# Optional — base currency (default: EUR)
# BASE_CURRENCY=EUR
